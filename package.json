{
  "name": "orcamentos",
  "version": "2.0.0-alpha.3",
  "buildDate": "2026-09-27",
  "description": "Orçamentos · precificação de Projetos, Fullcommerce e Fulfillment (Infracommerce)",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "compartilhado",
    "api",
    "web"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env api/src/principal.ts",
    "iniciar": "tsx --env-file-if-exists=.env api/src/principal.ts",
    "importar": "tsx --env-file-if-exists=.env api/src/importar.ts",
    "test": "vitest run",
    "typecheck": "tsc -p compartilhado && tsc -p api",
    "lint": "eslint .",
    "formatar": "prettier --write .",
    "formatacao": "prettier --check ."
  },
  "dependencies": {
    "plataforma-kit": "file:../plataforma-kit-1.2.0.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "license": "UNLICENSED"
}
