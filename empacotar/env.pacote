# Orçamentos · configuração para uso LOCAL (no seu computador).
# Em nuvem (Railway), NÃO use este arquivo: configure as variáveis no painel e defina DATABASE_URL.

PORT=3333

# Usuários de teste (senha teste123), só para experimentar no computador.
# Em nuvem este modo é ignorado automaticamente. Para uso real, apague a linha e crie o
# primeiro administrador com ADMIN_EMAIL e ADMIN_SENHA.
MODO_TESTE=1

# Dados locais: PGlite (PostgreSQL embutido) na pasta "dados", ao lado do server.js.
# Para migrar da v1.2.1: copie o data/db.json antigo para dados/db.json antes do primeiro início.
# DADOS_DIR=./dados

# ADMIN_EMAIL=
# ADMIN_SENHA=
